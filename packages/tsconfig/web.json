{
  "$schema": "https://json.schemastore.org/tsconfig",
  "//": "Web/Vite base (bundler resolution + DOM + JSX). Projects add include and any paths.",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
